{
  "type": "object",
  "properties": {
    "name": {
      "type": "string",
      "description": "会议名称"
    },
    "startTime": {
      "type": "string",
      "format": "date-time",
      "description": "会议开始时间,格式:YYYY-MM-DDTHH:mm:ss.sssZ"
    },
    "duration": {
      "type": "number",
      "description": "会议时长,单位:秒"
    },
    "isInvitationAllowed": {
      "type": "boolean",
      "description": "是否允许邀请"
    },
    "maxCount": {
      "type": "number",
      "description": "最大人数"
    },
    "includingMe": {
      "description": "是否把当前调用者（用户或开放接口调用方）作为主持人加入会议；为 false 时 members 中至少要有一个主持人"
    },
    "origin": {
      "description": "会议来源，如 system-created、co-interview，不传使用默认值 system-created"
    },
    "members": {
      "type": "array",
      "description": "会议成员，每项只保存下列声明的字段，其它字段（如 attended、shorten）会被忽略",
      "default": [],
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "description": "用户名称"
          },
          "nickname": {
            "type": "string",
            "description": "用户昵称"
          },
          "email": {
            "type": "string",
            "description": "用户邮箱"
          },
          "isMaster": {
            "type": "boolean",
            "description": "是否是主持人"
          },
          "avatar": {
            "description": "头像，http(s) 地址会被转存到文件服务后保存文件 ID"
          }
        }
      }
    },
    "options": {
      "type": "object",
      "description": "会议选项",
      "properties": {
        "document": {
          "type": "array",
          "description": "会议输入文档，每项为 { id, filename } 或 { url, filename }，http(s) url 会被转存到文件服务",
          "items": {
            "type": "object"
          }
        },
        "documentVisibleAll": {
          "type": "boolean",
          "description": "是否允许所有人查看文档",
          "default": false
        },
        "allowEarlyEnter": {
          "type": "boolean",
          "description": "是否允许提前进入房间",
          "default": false
        },
        "forceExitGrace": {
          "type": "number",
          "minimum": 0,
          "description": "计划结束时间之后再等待的分钟数，到时强制结束会议。0 表示到点立即结束"
        },
        "allowExtend": {
          "description": "是否允许主持人在会中延长会议时长"
        },
        "setting": {
          "description": "TRTC 设置：record（录制类型 audio / video）、speech（是否开启 AI 语音转写）、language、hotWordList 等，透传给 fastify-trtc"
        }
      }
    }
  },
  "required": ["name"]
}
